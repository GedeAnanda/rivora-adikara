# Salin bagian yang sesuai ke file .env di masing-masing folder.
# File .env JANGAN di-commit (sudah ada di .gitignore).

# ---------- backend/.env ----------
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rivora
# Supabase: Session pooler (IPv4), mis. postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# 1 = pakai SSL (wajib untuk Supabase), 0 = Postgres lokal
DB_SSL=0
JWT_SECRET=ganti-dengan-string-acak
# Password 4 akun demo (lurah, petugas1, petugas2, warga) yang dibuat oleh npm run seed
SEED_PASSWORD=

# AI vision: model multimodal, keluaran JSON (docs/RENCANA_FINAL.md bagian 5)
AI_API_KEY=
AI_MODEL=

# Firebase Cloud Messaging: path ke file service account (file-nya JANGAN di-commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Deploy cloud (tanpa file): isi JSON service account di-base64, menggantikan PATH
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Deploy: alamat publik API (dipakai seed untuk foto_url contoh) + folder foto di volume persisten
PUBLIC_URL=
UPLOAD_DIR=

# Deploy: foto disimpan di Supabase Storage (bucket publik "foto"). Kosong → disk lokal uploads/
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=foto

# [DEMO] saluran tujuan untuk lokasi_demo=true (FR-BE-21)
DEMO_SALURAN_ID=
# [DEMO] Titik di sekitar tempat uji asli (mis. selokan dekat rumah). Diisi → posisi HP digeser
# sejajar ke pusat kelurahan demo: selokan berbeda = saluran berbeda, radius verifikasi 30 m berlaku.
# Kosong → semua laporan lokasi_demo masuk ke satu saluran DEMO_SALURAN_ID.
DEMO_ASAL_LAT=
DEMO_ASAL_LNG=

# Open-Meteo tidak butuh API key
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# 1 = pakai hasil AI tersimpan untuk foto demo (docs/RENCANA_FINAL.md bagian 12)
DEMO_MODE=0

# ---------- dashboard (dibaca dari .env di akar repo, lihat dashboard/vite.config.js) ----------
VITE_API_URL=http://localhost:3000
# 0 = backend asli, 1 = data tiruan. Build produksi (Vercel) bawaannya 0 bila tidak diisi.
VITE_USE_MOCK=0
VITE_KELURAHAN_ID=1

# ---------- mobile ----------
# Flutter tidak membaca .env. Jalankan dengan:
#   flutter run --dart-define=API_URL=http://<IP-laptop>:3000
